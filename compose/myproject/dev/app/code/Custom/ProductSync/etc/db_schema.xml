<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="custom_product_sync" resource="default" engine="innodb" comment="Custom Product Sync Table">

        <column xsi:type="int"
                name="sync_id"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="Sync ID"/>

        <column xsi:type="varchar"
                name="product_name"
                nullable="false"
                length="255"
                comment="Product Name"/>

        <column xsi:type="varchar"
                name="sku"
                nullable="false"
                length="255"
                comment="SKU"/>

        <column xsi:type="decimal"
                name="price"
                scale="2"
                precision="12"
                nullable="false"
                default="0.00"
                comment="Price"/>

        <column xsi:type="smallint"
                name="status"
                nullable="false"
                default="1"
                comment="Status"/>

        <column xsi:type="timestamp"
                name="created_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="sync_id"/>
        </constraint>

    </table>

</schema>