<form method="post" action="<?= $block->getUrl('inventoryalert/index/save') ?>">
    <?= $block->getBlockHtml('formkey') ?>

    <div class="admin__fieldset">
        <div class="admin__field">
            <label class="admin__field-label">Product SKU</label>
            <div class="admin__field-control">
                <input class="admin__control-text" type="text" name="product_sku" required>
            </div>
        </div>

        <div class="admin__field">
            <label class="admin__field-label">Threshold Quantity</label>
            <div class="admin__field-control">
                <input class="admin__control-text" type="number" name="threshold_qty" value="0" required>
            </div>
        </div>

        <div class="admin__field">
            <label class="admin__field-label">Notification Email</label>
            <div class="admin__field-control">
                <input class="admin__control-text" type="email" name="notification_email" required>
            </div>
        </div>

        <div class="admin__field">
            <label class="admin__field-label">Status</label>
            <div class="admin__field-control">
                <select class="admin__control-select" name="status">
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                </select>
            </div>
        </div>

        <button type="submit" class="action-primary">Save Alert</button>
    </div>
</form>